    ],
    "rules_added": [
     "basis_referent_judgment"
    ]
   },
   "business_model_analysis": {
    "removed": [
     "The only evidence of commercial activity is the self-reported traction data: the company states 140,000+ bots [S1] and 500M messages (with an ambiguity in measurement basis between a cumulative total and a monthly rate [S2, S3]) in a slide context headed 'Traction by Apr-16'."
    ],
    "added": [
     "The only evidence of commercial activity is the self-reported traction data: the company states 140,000+ bots [S1] and 500M messages (with an ambiguity in measurement basis between a cumulative total and a monthly rate [S2]) in a slide context headed 'Traction by Apr-16', and separately 500M messages/month [S3] on page 12 (how the figure stated without an explicit interval relates to the monthly figure needs clarification before either is relied on)."
    ],
    "rules_added": [
     "basis_source_context"
    ]
   },
   "base_scenario": {
    "removed": [
     "Taking the self-reported traction metrics at face value [S1, S2, S3], ManyChat had built a sizeable bot and messaging platform by the period referenced in the 'Traction by Apr-16' slide context."
    ],
    "added": [
     "Taking the self-reported traction metrics at face value [S1, S2], ManyChat had built a sizeable bot and messaging platform by the period referenced in the 'Traction by Apr-16' slide context; the deck separately states 500M messages/month [S3] on page 12 (how the figure stated without an explicit interval relates to the monthly figure needs clarification before either is relied on)."
    ],
    "rules_added": [
     "basis_source_context"
    ]
   },
   "downside_scenario": {
    "removed": [
     "If the inconsistency between the cumulative and monthly presentations of the 500M messages figure [C2, C3] reflects imprecise metric reporting, and if the 140,000+ bots [S1] are predominantly unpaid or inactive, the platform's commercial value would be materially lower than the traction slides imply."
    ],
    "added": [
     "If the inconsistency between the unspecified-interval and monthly presentations of the 500M messages figure [C2, C3] reflects imprecise metric reporting, and if the 140,000+ bots [S1] are predominantly unpaid or inactive, the platform's commercial value would be materially lower than the traction slides imply."
    ],
    "rules_added": [
     "basis_cumulative_presupposed"
    ]
